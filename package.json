{
  "name": "pregunta-al-sitio",
  "version": "0.1.0",
  "description": "Chat flotante que responde con el contenido de tu sitio: buscador BM25F en el navegador, sin LLM ni backend al responder.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "pregunta-al-sitio": "cli/bin.mjs"
  },
  "exports": {
    ".": "./src/widget/widget.js",
    "./motor": "./src/motor/resolver.js",
    "./motor/*": "./src/motor/*.js",
    "./widget.js": "./dist/pregunta-al-sitio.js"
  },
  "files": [
    "src",
    "cli",
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test tests/",
    "build": "node cli/bin.mjs build",
    "validar": "node cli/bin.mjs validar",
    "evaluar": "node cli/bin.mjs evaluar",
    "calibrar": "node cli/bin.mjs calibrar",
    "empaquetar": "esbuild src/widget/index.js --bundle --minify --format=iife --target=es2022 --legal-comments=none --outfile=dist/pregunta-al-sitio.js",
    "dev": "node dev/servidor.mjs",
    "prepublishOnly": "npm run empaquetar && npm test"
  },
  "keywords": [
    "chat",
    "faq",
    "buscador",
    "bm25",
    "espanol",
    "widget"
  ],
  "dependencies": {
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
